# Optional backup. Without any key the app runs in Offline mode (rules-based extraction, template drafts).
ANTHROPIC_API_KEY=
# Optional model override for Live AI mode.
CLAUDE_MODEL=claude-opus-5-5
# Primary model for Live AI mode. If a Groq call fails, Claude (ANTHROPIC_API_KEY above) takes over.
# Eval results go to data/eval_results_groq.json.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
